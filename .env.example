# ====================================================================
# DISCORD MESSAGE FORWARDER CONFIGURATION
# ====================================================================

# 1. BOT CREDENTIALS
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 2. CHANNEL ROUTING (Primary 1-to-1 or 1-to-Many)
# Right-click channels in Discord (with Developer Mode ON) and "Copy Channel ID"
SOURCE_CHANNEL_ID=123456789012345678
TARGET_CHANNEL_ID=987654321098765432

# (Optional) Multi-Channel JSON Mapping:
# Allows routing from multiple source channels to different targets.
# Example:
# CHANNEL_MAPPINGS={"SOURCE_ID_1": "TARGET_ID_1", "SOURCE_ID_2": ["TARGET_ID_2", "TARGET_ID_3"]}
# CHANNEL_MAPPINGS=

# 3. SPECIFIC BOT & PERSON TRACKING (WHITELIST)
# If configured, the bot will ONLY track and forward messages from these specific users or bots!
# Leave blank to forward messages from everyone in the source channel.
# How to get IDs: Turn on Discord Developer Mode, right-click the person or bot -> "Copy User ID".
# Comma-separated:
TRACKED_USER_IDS=

# (Optional: specify bot and person separately if preferred)
# TRACKED_BOT_IDS=123456789012345678
# TRACKED_PERSON_IDS=987654321098765432

# 4. KEYWORD CONTENT FILTERING
# Only forward messages containing these keywords (case-insensitive).
# Scans raw message text, embed titles, descriptions, and fields.
REQUIRED_KEYWORDS=drop,giveaway,entries,entry,raffle,the drop has landed,open the box,open box
KEYWORD_FILTER_AUTHORS=1555661476839030826,960882470029524992
KEYWORD_FILTER_BOTS_ONLY=false
TIMO_KEYWORDS=drop,giveaway,entries,entry,raffle,the drop has landed,open the box,open box

# RAPID @EVERYONE BURST (Sends @everyone 5 times one by one in milliseconds)
RAPID_PING_COUNT=5
RAPID_PING_DELAY_MS=150

# 5. BEHAVIOR OPTIONS
# Set to 'true' to mirror sender's nickname and avatar via Webhook in destination (looks native)
USE_WEBHOOKS=true

# Ignore messages posted by other bots when TRACKED_USER_IDS is empty (true/false)
IGNORE_BOTS=false

# Sync edited messages to destination channel (true/false)
FORWARD_EDITS=true

# Sync deleted messages to destination channel (true/false)
FORWARD_DELETES=false

# Re-upload/forward attachments (images, files, videos) (true/false)
FORWARD_ATTACHMENTS=true

# Append a link to the original message (true/false)
INCLUDE_MESSAGE_LINK=false

# Allow @everyone or @here mentions in forwarded messages (true/false)
# Recommended 'false' to prevent notification spam
ALLOW_MENTIONS=false
